{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "gg.nerdzone.botmanager",
    "productName": "Nerdzone Bot Manager",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "dist", "to": "app-data/dist" },
      { "from": "scripts/panel-server.mjs", "to": "app-data/scripts/panel-server.mjs" },
      { "from": "bot-service/src", "to": "app-data/bot-service/src" },
      { "from": "bot-service/node_modules", "to": "app-data/bot-service/node_modules" },
      { "from": "bot-service/package.json", "to": "app-data/bot-service/package.json" }
      ,{ "from": "assets/minecontrol-icon.png", "to": "app-data/assets/minecontrol-icon.png" }
    ],
    "win": {
      "target": "portable",
      "artifactName": "Nerdzone Bot Manager Desktop.exe",
      "icon": "assets/minecontrol-icon.ico"
    },
    "directories": { "output": "desktop-release" }
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
